# Copy to .env next to docker-compose.yml, then `chmod 600 .env`. Never commit it.

# Onshape OAuth app (per-user sign-in, docs/ONSHAPE_SETUP.md). The client ID goes in config.toml.
ONSHAPE_OAUTH_CLIENT_SECRET=
# Or, with [onshape] auth = "keys": one read-only API key pair.
#ONSHAPE_ACCESS_KEY=
#ONSHAPE_SECRET_KEY=

# BamBuddy API key (read status, library, queue). Any value if BamBuddy auth is off.
BAMBUDDY_API_KEY=

# Optional: password for the web Bambu Studio (user "bambu"); empty = no password.
WEB_STUDIO_PASSWORD=
TZ=America/Los_Angeles

# Optional `duckdns` service: the name, its token, this machine's LAN address, and an
# email for Let's Encrypt.
DUCKDNS_DOMAIN=print.example.duckdns.org
DUCKDNS_TOKEN=
LAN_IP=192.168.1.10
ACME_EMAIL=

# Optional `orca` profile: the OrcaSlicer vendor folder your printer's system presets
# come from (BBL, Ratrig, Voron, Prusa, ...), and the sidecar image tag.
#ORCA_VENDOR=BBL
#ORCA_API_TAG=latest

# Optional `orca-web` profile (OrcaSlicer in a browser, user "orca"): its password. Set
# one: the app keeps your Orca account signed in.
#WEB_ORCA_PASSWORD=
